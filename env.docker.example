# Copy to .env and adjust. Used by docker-compose for overrides.
# All services (app + Ollama) run on the same host; no cloud DB or LLM.

# Ollama (in Docker: http://ollama:11434; on host: http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://ollama:11434

# Bot paths (inside container)
BOT_WORKDIR=/app/bot
BOT_PYTHON_PATH=python3
BOT_CONFIG_PATH=config/config.yaml

# Optional: public URL for links (leave blank for localhost)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
